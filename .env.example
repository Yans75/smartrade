# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real keys.

# --- Supabase (your own project, not shared with any other app) ---
# Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only, bypasses RLS — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Same values as above, exposed to the browser (Vite requires the VITE_ prefix).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- DeepSeek (AI signal generation) ---
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Exact model id from your DeepSeek account/docs — there is no default,
# the app refuses to generate signals until this is set.
DEEPSEEK_MODEL=
