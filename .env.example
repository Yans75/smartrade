# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real keys.

# --- Supabase (your own project, not shared with any other app) ---
# Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only, bypasses RLS — never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Same values as above, exposed to the browser (Vite requires the VITE_ prefix).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- TypeSafe AI / moteur Jev (décision des signaux) ---
# https://typesafe.ai — la clé est la seule variable obligatoire ici.
TYPESAFE_API_KEY=
# Tout le reste a un défaut sain ; ne les renseigner que pour un test.
# Alias du modèle (défaut : jev-latest). GET /v1/models liste les alias valides.
TYPESAFE_MODEL=
# Plafond par tentative, en ms (défaut : 8000). Jev est un modèle "System One" :
# il répond sans raisonnement intermédiaire, une réponse lente est anormale.
TYPESAFE_TIMEOUT_MS=
# Nouvelles tentatives après un échec réessayable, 408/429/5xx (défaut : 1).
TYPESAFE_MAX_RETRIES=
# Base de l'API (défaut : https://api.typesafe.ai). À ne changer que pour un mock.
TYPESAFE_BASE_URL=
